# Copy this file to .env and add at least ONE AI key. Restart the app after editing.

# Gemini (FREE tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ChatGPT / OpenAI (paid, no free tier): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional
# AI_PROVIDER=gemini             # default choice in the app: gemini | claude | openai
# GEMINI_MODEL=gemini-3.8-flash  # best free model. Paid top model: gemini-4-argon
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6-astra       # cheaper: gpt-6.1-sol, gpt-6-luna
# AUTOYT_RESOLUTION=720          # render at 720p instead of 1080p (about 2x faster on slow PCs)
# AUTOYT_X264_PRESET=veryfast    # ultrafast | veryfast | fast | medium
# YOUTUBE_CLIENT_SECRET=client_secret.json
